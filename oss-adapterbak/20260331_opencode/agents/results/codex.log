    65	  function wrapSSE(res: Response, ms: number, ctl: AbortController) {
    66	    if (typeof ms !== "number" || ms <= 0) return res
    67	    if (!res.body) return res
    68	    if (!res.headers.get("content-type")?.includes("text/event-stream")) return res
    69	
    70	    const reader = res.body.getReader()
    71	    const body = new ReadableStream<Uint8Array>({
    72	      async pull(ctrl) {
    73	        const part = await new Promise<Awaited<ReturnType<typeof reader.read>>>((resolve, reject) => {
    74	          const id = setTimeout(() => {
    75	            const err = new Error("SSE read timed out")
    76	            ctl.abort(err)
    77	            void reader.cancel(err)
    78	            reject(err)
    79	          }, ms)
    80	
    81	          reader.read().then(
    82	            (part) => {
    83	              clearTimeout(id)
    84	              resolve(part)
    85	            },
    86	            (err) => {
    87	              clearTimeout(id)
    88	              reject(err)
    89	            },
    90	          )
    91	        })
    92	
    93	        if (part.done) {
    94	          ctrl.close()
    95	          return
    96	        }
    97	
    98	        ctrl.enqueue(part.value)
    99	      },
   100	      async cancel(reason) {
   101	        ctl.abort(reason)
   102	        await reader.cancel(reason)
   103	      },
   104	    })
