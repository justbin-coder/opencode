    80	      } catch (err) {
    81	        throw new FrontmatterError(
    82	          {
    83	            path: filePath,
    84	            message: `${filePath}: Failed to parse YAML frontmatter: ${err instanceof Error ? err.message : String(err)}`,
    85	          },
    86	          { cause: err },
