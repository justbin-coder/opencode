   266	      )
   267	
   268	      const trigger = Effect.fn("Plugin.trigger")(function* <
   269	        Name extends TriggerName,
   270	        Input = Parameters<Required<Hooks>[Name]>[0],
   271	        Output = Parameters<Required<Hooks>[Name]>[1],
   272	      >(name: Name, input: Input, output: Output) {
   273	        if (!name) return output
