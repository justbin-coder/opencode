    66	  function getLegacyPlugins(mod: Record<string, unknown>) {
    67	    const seen = new Set<unknown>()
    68	    const result: PluginInstance[] = []
    69	
    70	    for (const entry of Object.values(mod)) {
    71	      if (seen.has(entry)) continue
    72	      seen.add(entry)
    73	      const plugin = getServerPlugin(entry)
    74	      if (!plugin) throw new TypeError("Plugin export is not a function")
    75	      result.push(plugin)
    76	    }
    77	
    78	    return result
    79	  }
