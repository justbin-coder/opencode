   236	                  }).toObject(),
   237	                }),
   238	              ),
   239	            )
   240	          }
   241	
   242	          // Notify plugins of current config
   243	          for (const hook of hooks) {
   244	            yield* Effect.tryPromise({
   245	              try: () => Promise.resolve((hook as any).config?.(cfg)),
   246	              catch: (err) => {
