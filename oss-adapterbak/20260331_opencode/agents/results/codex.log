   172	export function resolvePluginProviders(input: {
   173	  hooks: Hooks[]
   174	  existingProviders: Record<string, unknown>
   175	  disabled: Set<string>
   176	  enabled?: Set<string>
   177	  providerNames: Record<string, string | undefined>
   178	}): Array<{ id: string; name: string }> {
   179	  const seen = new Set<string>()
   180	  const result: Array<{ id: string; name: string }> = []
   181	
   182	  for (const hook of input.hooks) {
   183	    if (!hook.auth) continue
   184	    const id = hook.auth.provider
   185	    if (seen.has(id)) continue
   186	    seen.add(id)
   187	    if (Object.hasOwn(input.existingProviders, id)) continue
   188	    if (input.disabled.has(id)) continue
   189	    if (input.enabled && !input.enabled.has(id)) continue
   190	    result.push({
   191	      id,
   192	      name: input.providerNames[id] ?? id,
   193	    })
   194	  }
   195	
   196	  return result
   197	}
