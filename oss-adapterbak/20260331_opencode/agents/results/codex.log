   205	                  Bus.publish(Session.Event.Error, {
   206	                    error: new NamedError.Unknown({
   207	                      message: `Failed to load plugin ${plan.spec}: ${message}`,
   208	                    }).toObject(),
   209	                  })
   210	                  return
   211	                }
   212	
   213	                return {
   214	                  row: mod.value,
   215	                }
   216	              }),
   217	            ),
   218	          )
   219	          for (const load of loaded) {
   220	            if (!load) continue
