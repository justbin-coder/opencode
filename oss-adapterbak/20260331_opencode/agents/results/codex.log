    81	  async function applyPlugin(load: Loaded, input: PluginInput, hooks: Hooks[]) {
    82	    const plugin = readV1Plugin(load.row.mod, load.row.spec, "server", "detect")
    83	    if (plugin) {
    84	      await resolvePluginId(
    85	        load.row.source,
    86	        load.row.spec,
    87	        load.row.target,
    88	        readPluginId(plugin.id, load.row.spec),
    89	        load.row.pkg,
    90	      )
    91	      hooks.push(await (plugin as PluginModule).server(input, load.row.options))
    92	      return
    93	    }
    94	
    95	    for (const server of getLegacyPlugins(load.row.mod)) {
    96	      hooks.push(await server(input, load.row.options))
    97	    }
    98	  }
