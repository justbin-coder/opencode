   164	                  if (resolved.stage === "install") {
   165	                    const parsed = parsePluginSpecifier(plan.spec)
   166	                    log.error("failed to install plugin", {
   167	                      pkg: parsed.pkg,
   168	                      version: parsed.version,
   169	                      error: message,
   170	                    })
   171	                    Bus.publish(Session.Event.Error, {
   172	                      error: new NamedError.Unknown({
   173	                        message: `Failed to install plugin ${parsed.pkg}@${parsed.version}: ${message}`,
   174	                      }).toObject(),
   175	                    })
   176	                    return
   177	                  }
   178	
   179	                  if (resolved.stage === "compatibility") {
   180	                    log.warn("plugin incompatible", { path: plan.spec, error: message })
   181	                    Bus.publish(Session.Event.Error, {
   182	                      error: new NamedError.Unknown({
   183	                        message: `Plugin ${plan.spec} skipped: ${message}`,
   184	                      }).toObject(),
   185	                    })
   186	                    return
   187	                  }
   188	
   189	                  log.error("failed to resolve plugin server entry", {
   190	                    path: plan.spec,
   191	                    error: message,
   192	                  })
   193	                  Bus.publish(Session.Event.Error, {
   194	                    error: new NamedError.Unknown({
   195	                      message: `Failed to load plugin ${plan.spec}: ${message}`,
