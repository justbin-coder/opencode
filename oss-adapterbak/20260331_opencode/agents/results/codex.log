     6	export namespace ConfigMarkdown {
     7	  export const FILE_REGEX = /(?<![\w`])@(\.?[^\s`,.]*(?:\.[^\s`,.]+)*)/g
     8	  export const SHELL_REGEX = /!`([^`]+)`/g
     9	
    10	  export function files(template: string) {
    11	    return Array.from(template.matchAll(FILE_REGEX))
    12	  }
    13	
    14	  export function shell(template: string) {
    15	    return Array.from(template.matchAll(SHELL_REGEX))
    16	  }
