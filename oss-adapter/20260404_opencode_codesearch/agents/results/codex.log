现在写一个临时 server plugin 探针到 `/tmp/opencode-prompt-probe.ts`：它只记录 `chat.message`、`experimental.chat.messages.transform`、`experimental.chat.system.transform`、`tool.definition`，然后在 `chat.params` 抛 `probe-stop`，确保请求不会真正发到模型服务。
apply patch
patch: completed
/tmp/opencode-prompt-probe.ts
diff --git a//tmp/opencode-prompt-probe.ts b//tmp/opencode-prompt-probe.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d9ce9ba8970b66118e3fe82a10face1e70ef5f4c
--- /dev/null
+++ b//tmp/opencode-prompt-probe.ts
@@ -0,0 +1,66 @@
+const file = "/tmp/opencode-prompt-capture.json"
+
+async function save(next: Record<string, unknown>) {
+  let prev: Record<string, unknown> = {}
+  try {
+    prev = await Bun.file(file).json()
+  } catch {}
+  await Bun.write(file, JSON.stringify({ ...prev, ...next }, null, 2))
+}
+
+const plugin = {
+  id: "prompt-probe",
+  server: async () => ({
+    async "chat.message"(input, output) {
+      await save({
+        chatMessage: {
+          input,
+          parts: output.parts.map((part) =>
+            part.type === "text"
+              ? { type: part.type, text: part.text, synthetic: Boolean(part.synthetic) }
+              : { type: part.type, mime: "mime" in part ? part.mime : undefined, filename: "filename" in part ? part.filename : undefined }
+          ),
+        },
+      })
+    },
+    async "experimental.chat.messages.transform"(_, output) {
+      await save({
+        modelMessages: output.messages.map((msg) => ({
+          role: msg.info.role,
+          agent: "agent" in msg.info ? msg.info.agent : undefined,
+          parts: msg.parts.map((part) =>
+            part.type === "text"
+              ? { type: part.type, text: part.text, synthetic: Boolean(part.synthetic) }
+              : { type: part.type, tool: "tool" in part ? part.tool : undefined }
+          ),
+        })),
+      })
+    },
+    async "experimental.chat.system.transform"(input, output) {
+      await save({
+        systemHook: {
+          input,
+          system: output.system,
+        },
+      })
+    },
+    async "tool.definition"(input, output) {
+      const prev = await Bun.file(file).json().catch(() => ({}))
+      const defs = Array.isArray(prev.toolDefinitions) ? prev.toolDefinitions : []
+      if (["read", "grep", "glob", "task", "codesearch", "github-pr-search", "github-triage"].includes(input.toolID)) {
+        defs.push({
+          toolID: input.toolID,
+          description: output.description,
+          parameters: output.parameters,
+        })
+        await save({ toolDefinitions: defs })
+      }
+    },
+    async "chat.params"() {
+      await save({ paramsHookReached: true })
+      throw new Error("probe-stop")
+    },
+  }),
+}
+
+export default plugin

