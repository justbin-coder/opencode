    75	  // Custom merge function that concatenates array fields instead of replacing them
    76	  function mergeConfigConcatArrays(target: Info, source: Info): Info {
    77	    const merged = mergeDeep(target, source)
    78	    if (target.plugin && source.plugin) {
    79	      merged.plugin = Array.from(new Set([...target.plugin, ...source.plugin]))
    80	    }
    81	    if (target.instructions && source.instructions) {
    82	      merged.instructions = Array.from(new Set([...target.instructions, ...source.instructions]))
    83	    }
    84	    return merged
