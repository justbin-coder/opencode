   118	  export function close() {
   119	    Client().$client.close()
   120	    Client.reset()
   121	  }
   122	
   123	  export type TxOrDb = Transaction | Client
   124	
   125	  const ctx = Context.create<{
   126	    tx: TxOrDb
   127	    effects: (() => void | Promise<void>)[]
   128	  }>("database")
   129	
   130	  export function use<T>(callback: (trx: TxOrDb) => T): T {
   131	    try {
   132	      return callback(ctx.use().tx)
   133	    } catch (err) {
   134	      if (err instanceof Context.NotFound) {
   135	        const effects: (() => void | Promise<void>)[] = []
   136	        const result = ctx.provide({ effects, tx: Client() }, () => callback(Client()))
   137	        for (const effect of effects) effect()
   138	        return result
   139	      }
   140	      throw err
   141	    }
   142	  }
   143	
   144	  export function effect(fn: () => any | Promise<any>) {
   145	    try {
   146	      ctx.use().effects.push(fn)
   147	    } catch {
   148	      fn()
   149	    }
   150	  }
   151	
   152	  type NotPromise<T> = T extends Promise<any> ? never : T
   153	
   154	  export function transaction<T>(
   155	    callback: (tx: TxOrDb) => NotPromise<T>,
   156	    options?: {
   157	      behavior?: "deferred" | "immediate" | "exclusive"
   158	    },
   159	  ): NotPromise<T> {
   160	    try {
   161	      return callback(ctx.use().tx)
   162	    } catch (err) {
   163	      if (err instanceof Context.NotFound) {
   164	        const effects: (() => void | Promise<void>)[] = []
   165	        const result = Client().transaction(
   166	          (tx: TxOrDb) => {
   167	            return ctx.provide({ tx, effects }, () => callback(tx))
   168	          },
   169	          { behavior: options?.behavior },
   170	        )
   171	        for (const effect of effects) effect()
   172	        return result as NotPromise<T>
   173	      }
   174	      throw err
   175	    }
   176	  }
   177	}

