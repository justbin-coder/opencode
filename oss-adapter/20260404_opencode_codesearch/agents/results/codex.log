    87	  export type InstallInput = {
    88	    signal?: AbortSignal
    89	    waitTick?: (input: { dir: string; attempt: number; delay: number; waited: number }) => void | Promise<void>
    90	  }
    91	
    92	  export async function installDependencies(dir: string, input?: InstallInput) {
    93	    if (!(await needsInstall(dir))) return
    94	
    95	    await using _ = await Flock.acquire(`config-install:${Filesystem.resolve(dir)}`, {
    96	      signal: input?.signal,
    97	      onWait: (tick) =>
    98	        input?.waitTick?.({
    99	          dir,
   100	          attempt: tick.attempt,
   101	          delay: tick.delay,
   102	          waited: tick.waited,
   103	        }),
   104	    })
   105	
   106	    input?.signal?.throwIfAborted()
   107	    if (!(await needsInstall(dir))) return
   108	
   109	    const pkg = path.join(dir, "package.json")
   110	    const target = Installation.isLocal() ? "*" : Installation.VERSION
   111	
   112	    const json = await Filesystem.readJson<{ dependencies?: Record<string, string> }>(pkg).catch(() => ({
   113	      dependencies: {},
   114	    }))
   115	    json.dependencies = {
   116	      ...json.dependencies,
   117	      "@opencode-ai/plugin": target,
   118	    }
   119	    await Filesystem.writeJson(pkg, json)
   120	
   121	    const gitignore = path.join(dir, ".gitignore")
   122	    const ignore = await Filesystem.exists(gitignore)
   123	    if (!ignore) {
   124	      await Filesystem.write(gitignore, ["node_modules", "package.json", "bun.lock", ".gitignore"].join("\n"))
   125	    }
   126	
   127	    // Bun can race cache writes on Windows when installs run in parallel across dirs.
   128	    // Serialize installs globally on win32, but keep parallel installs on other platforms.
   129	    await using __ =
   130	      process.platform === "win32"
   131	        ? await Flock.acquire("config-install:bun", {
   132	            signal: input?.signal,
   133	          })
   134	        : undefined
   135	
   136	    await BunProc.run(
   137	      [
   138	        "install",
   139	        // TODO: get rid of this case (see: https://github.com/oven-sh/bun/issues/19936)
   140	        ...(proxied() || process.env.CI ? ["--no-cache"] : []),
   141	      ],
   142	      {
   143	        cwd: dir,
   144	        abort: input?.signal,
   145	      },
   146	    ).catch((err) => {
   147	      if (err instanceof Process.RunFailedError) {
   148	        const detail = {
   149	          dir,
   150	          cmd: err.cmd,
   151	          code: err.code,
   152	          stdout: err.stdout.toString(),
   153	          stderr: err.stderr.toString(),
   154	        }
   155	        if (Flag.OPENCODE_STRICT_CONFIG_DEPS) {
   156	          log.error("failed to install dependencies", detail)
   157	          throw err
   158	        }
   159	        log.warn("failed to install dependencies", detail)
   160	        return
   161	      }
   162	
   163	      if (Flag.OPENCODE_STRICT_CONFIG_DEPS) {
   164	        log.error("failed to install dependencies", { dir, error: err })
   165	        throw err
   166	      }
   167	      log.warn("failed to install dependencies", { dir, error: err })
   168	    })
   169	  }
