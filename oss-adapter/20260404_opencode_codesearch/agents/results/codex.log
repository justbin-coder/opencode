   230	  async function loadCommand(dir: string) {
   231	    const result: Record<string, Command> = {}
   232	    for (const item of await Glob.scan("{command,commands}/**/*.md", {
   233	      cwd: dir,
   234	      absolute: true,
   235	      dot: true,
   236	      symlink: true,
   237	    })) {
   238	      const md = await ConfigMarkdown.parse(item).catch(async (err) => {
   239	        const message = ConfigMarkdown.FrontmatterError.isInstance(err)
   240	          ? err.data.message
   241	          : `Failed to parse command ${item}`
   242	        const { Session } = await import("@/session")
   243	        Bus.publish(Session.Event.Error, { error: new NamedError.Unknown({ message }).toObject() })
   244	        log.error("failed to load command", { command: item, err })
   245	        return undefined
   246	      })
   247	      if (!md) continue
   248	
   249	      const patterns = ["/.opencode/command/", "/.opencode/commands/", "/command/", "/commands/"]
   250	      const file = rel(item, patterns) ?? path.basename(item)
   251	      const name = trim(file)
   252	
   253	      const config = {
   254	        name,
   255	        ...md.data,
   256	        template: md.content.trim(),
   257	      }
   258	      const parsed = Command.safeParse(config)
   259	      if (parsed.success) {
   260	        result[config.name] = parsed.data
   261	        continue
   262	      }
   263	      throw new InvalidError({ path: item, issues: parsed.error.issues }, { cause: parsed.error })
   264	    }
   265	    return result
   266	  }
