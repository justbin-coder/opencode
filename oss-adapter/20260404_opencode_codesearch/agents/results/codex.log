+const file = "/tmp/opencode-prompt-capture.json"
+
+async function save(next: Record<string, unknown>) {
+  let prev: Record<string, unknown> = {}
+  try {
+    prev = await Bun.file(file).json()
+  } catch {}
+  await Bun.write(file, JSON.stringify({ ...prev, ...next }, null, 2))
+}
