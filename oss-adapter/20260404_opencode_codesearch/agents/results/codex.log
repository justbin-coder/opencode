   171	  async function isWritable(dir: string) {
   172	    try {
   173	      await fsNode.access(dir, constants.W_OK)
   174	      return true
   175	    } catch {
   176	      return false
   177	    }
   178	  }
   179	
   180	  export async function needsInstall(dir: string) {
   181	    // Some config dirs may be read-only.
   182	    // Installing deps there will fail; skip installation in that case.
   183	    const writable = await isWritable(dir)
   184	    if (!writable) {
   185	      log.debug("config dir is not writable, skipping dependency install", { dir })
   186	      return false
   187	    }
   188	
   189	    const mod = path.join(dir, "node_modules", "@opencode-ai", "plugin")
   190	    if (!existsSync(mod)) return true
   191	
   192	    const pkg = path.join(dir, "package.json")
   193	    const pkgExists = await Filesystem.exists(pkg)
   194	    if (!pkgExists) return true
   195	
   196	    const parsed = await Filesystem.readJson<{ dependencies?: Record<string, string> }>(pkg).catch(() => null)
   197	    const dependencies = parsed?.dependencies ?? {}
   198	    const depVersion = dependencies["@opencode-ai/plugin"]
   199	    if (!depVersion) return true
   200	
   201	    const targetVersion = Installation.isLocal() ? "latest" : Installation.VERSION
   202	    if (targetVersion === "latest") {
   203	      if (!online()) return false
   204	      const stale = await PackageRegistry.isOutdated("@opencode-ai/plugin", depVersion, dir)
   205	      if (!stale) return false
   206	      log.info("Cached version is outdated, proceeding with install", {
   207	        pkg: "@opencode-ai/plugin",
   208	        cachedVersion: depVersion,
   209	      })
   210	      return true
   211	    }
   212	    if (depVersion === targetVersion) return false
   213	    return true
   214	  }
