+const file = "/tmp/opencode-prompt-capture.json"
+
+async function save(next: Record<string, unknown>) {
+  let prev: Record<string, unknown> = {}
+  try {
+    prev = await Bun.file(file).json()
+  } catch {}
+  await Bun.write(file, JSON.stringify({ ...prev, ...next }, null, 2))
+}
+
+const plugin = {
+  id: "prompt-probe",
+  server: async () => ({
+    async "chat.message"(input, output) {
+      await save({
+        chatMessage: {
+          input,
+          parts: output.parts.map((part) =>
+            part.type === "text"
+              ? { type: part.type, text: part.text, synthetic: Boolean(part.synthetic) }
+              : { type: part.type, mime: "mime" in part ? part.mime : undefined, filename: "filename" in part ? part.filename : undefined }
+          ),
+        },
+      })
+    },
+    async "experimental.chat.messages.transform"(_, output) {
+      await save({
+        modelMessages: output.messages.map((msg) => ({
+          role: msg.info.role,
+          agent: "agent" in msg.info ? msg.info.agent : undefined,
+          parts: msg.parts.map((part) =>
+            part.type === "text"
+              ? { type: part.type, text: part.text, synthetic: Boolean(part.synthetic) }
+              : { type: part.type, tool: "tool" in part ? part.tool : undefined }
+          ),
+        })),
+      })
+    },
+    async "experimental.chat.system.transform"(input, output) {
+      await save({
+        systemHook: {
+          input,
+          system: output.system,
+        },
+      })
+    },
+    async "tool.definition"(input, output) {
