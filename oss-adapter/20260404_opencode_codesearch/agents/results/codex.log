   243	    case ".tar":
   244	    case ".gz":
   245	    case ".exe":
   246	    case ".dll":
   247	    case ".so":
   248	    case ".class":
   249	    case ".jar":
   250	    case ".war":
   251	    case ".7z":
   252	    case ".doc":
   253	    case ".docx":
   254	    case ".xls":
   255	    case ".xlsx":
   256	    case ".ppt":
   257	    case ".pptx":
   258	    case ".odt":
   259	    case ".ods":
   260	    case ".odp":
   261	    case ".bin":
   262	    case ".dat":
   263	    case ".obj":
   264	    case ".o":
   265	    case ".a":
   266	    case ".lib":
   267	    case ".wasm":
   268	    case ".pyc":
   269	    case ".pyo":
   270	      return true
   271	    default:
   272	      break
   273	  }
   274	
   275	  if (fileSize === 0) return false
   276	
   277	  const fh = await fs.open(filepath, "r")
   278	  try {
   279	    const sampleSize = Math.min(4096, fileSize)
   280	    const bytes = Buffer.alloc(sampleSize)
   281	    const result = await fh.read(bytes, 0, sampleSize, 0)
   282	    if (result.bytesRead === 0) return false
