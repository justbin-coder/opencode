   473	
   474	    // 计算整体分数 (0-100)
   475	    const errorPenalty = this.issues.filter(i => i.type === 'error').length * 5;
   476	    const warningPenalty = this.issues.filter(i => i.type === 'warning').length * 2;
   477	    const overallScore = Math.max(0, 100 - errorPenalty - warningPenalty);
   478	
   479	    return {
   480	      file: this.filePath,
   481	      totalLines: this.lines.length,
   482	      testCount: this.testScenarios.length,
   483	      scenarioCoverage: coverage,
   484	      issues: this.issues,
   485	      summary: {
   486	        totalIssues: this.issues.length,
   487	        errorCount: this.issues.filter(i => i.type === 'error').length,
   488	        warningCount: this.issues.filter(i => i.type === 'warning').length,
   489	        emptyAssertions: this.issues.filter(i => i.code === 'E001' || i.code === 'E002').length,
   490	        scenarioCoverage: scenarioCoverageScore,
   491	        overallScore: Math.round(overallScore),
   492	      },
   493	      timestamp: new Date().toISOString(),
   494	    };
   495	  }
   496	
   497	  /**
   498	   * 计算场景覆盖分数
   499	   */
   500	  private calculateScenarioCoverage(): number {
   501	    if (this.testScenarios.length === 0) return 0;
   502	
   503	    const coverage = {
   504	      normal: 0,
   505	      boundary: 0,
   506	      exception: 0,
   507	    };
   508	
   509	    for (const scenario of this.testScenarios) {
   510	      if (coverage[scenario.scenarioType] !== undefined) {
   511	        coverage[scenario.scenarioType]++;
   512	      }
   513	    }
   514	
   515	    // 如果所有三类场景都有，给 100 分
   516	    if (coverage.normal > 0 && coverage.boundary > 0 && coverage.exception > 0) {
   517	      return 100;
   518	    }
   519	
   520	    // 否则按比例计分
   521	    const hasCoverage = Object.values(coverage).filter(v => v > 0).length;
   522	    return Math.round((hasCoverage / 3) * 100);
   523	  }
   524	}
