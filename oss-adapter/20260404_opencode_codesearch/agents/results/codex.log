   459	  private generateReport(): ValidationReport {
   460	    const coverage = {
   461	      normal: 0,
   462	      boundary: 0,
   463	      exception: 0,
   464	      unknown: 0,
   465	    };
   466	
   467	    for (const scenario of this.testScenarios) {
   468	      coverage[scenario.scenarioType]++;
   469	    }
   470	
   471	    // 计算场景覆盖分数 (0-100)
