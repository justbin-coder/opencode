   216	  function rel(item: string, patterns: string[]) {
   217	    const normalizedItem = item.replaceAll("\\", "/")
   218	    for (const pattern of patterns) {
   219	      const index = normalizedItem.indexOf(pattern)
   220	      if (index === -1) continue
   221	      return normalizedItem.slice(index + pattern.length)
   222	    }
   223	  }
