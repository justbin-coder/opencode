    48	      agent?: Agent.Info,
    49	    ) => Effect.Effect<(Tool.Def & { id: string })[]>
    50	  }
    51	
    52	  export class Service extends ServiceMap.Service<Service, Interface>()("@opencode/ToolRegistry") {}
    53	
    54	  export const layer: Layer.Layer<Service, never, Config.Service | Plugin.Service> = Layer.effect(
    55	    Service,
    56	    Effect.gen(function* () {
    57	      const config = yield* Config.Service
    58	      const plugin = yield* Plugin.Service
    59	
    60	      const cache = yield* InstanceState.make<State>(
    61	        Effect.fn("ToolRegistry.state")(function* (ctx) {
    62	          const custom: Tool.Info[] = []
    63	
    64	          function fromPlugin(id: string, def: ToolDefinition): Tool.Info {
    65	            return {
    66	              id,
    67	              init: async (initCtx) => ({
    68	                parameters: z.object(def.args),
    69	                description: def.description,
    70	                execute: async (args, toolCtx) => {
    71	                  const pluginCtx = {
    72	                    ...toolCtx,
    73	                    directory: ctx.directory,
    74	                    worktree: ctx.worktree,
    75	                  } as unknown as PluginToolContext
    76	                  const result = await def.execute(args as any, pluginCtx)
    77	                  const out = await Truncate.output(result, {}, initCtx?.agent)
    78	                  return {
    79	                    title: "",
    80	                    output: out.truncated ? out.content : result,
    81	                    metadata: { truncated: out.truncated, outputPath: out.truncated ? out.outputPath : undefined },
    82	                  }
    83	                },
    84	              }),
    85	            }
    86	          }
    87	
    88	          const dirs = yield* config.directories()
    89	          const matches = dirs.flatMap((dir) =>
    90	            Glob.scanSync("{tool,tools}/*.{js,ts}", { cwd: dir, absolute: true, dot: true, symlink: true }),
    91	          )
    92	          if (matches.length) yield* config.waitForDependencies()
    93	          for (const match of matches) {
    94	            const namespace = path.basename(match, path.extname(match))
    95	            const mod = yield* Effect.promise(
    96	              () => import(process.platform === "win32" ? match : pathToFileURL(match).href),
    97	            )
    98	            for (const [id, def] of Object.entries<ToolDefinition>(mod)) {
    99	              custom.push(fromPlugin(id === "default" ? namespace : `${namespace}_${id}`, def))
   100	            }
   101	          }
   102	
   103	          const plugins = yield* plugin.list()
   104	          for (const p of plugins) {
   105	            for (const [id, def] of Object.entries(p.tool ?? {})) {
   106	              custom.push(fromPlugin(id, def))
   107	            }
   108	          }
   109	
   110	          return { custom }
   111	        }),
   112	      )
   113	
   114	      const all = Effect.fn("ToolRegistry.all")(function* (custom: Tool.Info[]) {
   115	        const cfg = yield* config.get()
   116	        const question = ["app", "cli", "desktop"].includes(Flag.OPENCODE_CLIENT) || Flag.OPENCODE_ENABLE_QUESTION_TOOL
   117	
   118	        return [
   119	          InvalidTool,
   120	          ...(question ? [QuestionTool] : []),
   121	          BashTool,
   122	          ReadTool,
   123	          GlobTool,
   124	          GrepTool,
   125	          EditTool,
   126	          WriteTool,
   127	          TaskTool,
   128	          WebFetchTool,
   129	          TodoWriteTool,
   130	          WebSearchTool,
   131	          CodeSearchTool,
   132	          SkillTool,
   133	          ApplyPatchTool,
   134	          ...(Flag.OPENCODE_EXPERIMENTAL_LSP_TOOL ? [LspTool] : []),
   135	          ...(cfg.experimental?.batch_tool === true ? [BatchTool] : []),
   136	          ...(Flag.OPENCODE_EXPERIMENTAL_PLAN_MODE && Flag.OPENCODE_CLIENT === "cli" ? [PlanExitTool] : []),
   137	          ...custom,
   138	        ]
   139	      })
   140	
   141	      const register = Effect.fn("ToolRegistry.register")(function* (tool: Tool.Info) {
   142	        const state = yield* InstanceState.get(cache)
   143	        const idx = state.custom.findIndex((t) => t.id === tool.id)
   144	        if (idx >= 0) {
   145	          state.custom.splice(idx, 1, tool)
   146	          return
   147	        }
   148	        state.custom.push(tool)
   149	      })
   150	
   151	      const ids = Effect.fn("ToolRegistry.ids")(function* () {
   152	        const state = yield* InstanceState.get(cache)
   153	        const tools = yield* all(state.custom)
   154	        return tools.map((t) => t.id)
   155	      })
   156	
   157	      const tools = Effect.fn("ToolRegistry.tools")(function* (
   158	        model: { providerID: ProviderID; modelID: ModelID },
   159	        agent?: Agent.Info,
   160	      ) {
   161	        const state = yield* InstanceState.get(cache)
   162	        const allTools = yield* all(state.custom)
   163	        const filtered = allTools.filter((tool) => {
   164	          if (tool.id === "codesearch" || tool.id === "websearch") {
   165	            return model.providerID === ProviderID.opencode || Flag.OPENCODE_ENABLE_EXA
   166	          }
   167	
   168	          const usePatch =
   169	            model.modelID.includes("gpt-") && !model.modelID.includes("oss") && !model.modelID.includes("gpt-4")
   170	          if (tool.id === "apply_patch") return usePatch
   171	          if (tool.id === "edit" || tool.id === "write") return !usePatch
   172	
   173	          return true
   174	        })
   175	        return yield* Effect.forEach(
   176	          filtered,
   177	          Effect.fnUntraced(function* (tool: Tool.Info) {
   178	            using _ = log.time(tool.id)
   179	            const next = yield* Effect.promise(() => tool.init({ agent }))
   180	            const output = {
   181	              description: next.description,
   182	              parameters: next.parameters,
   183	            }
   184	            yield* plugin.trigger("tool.definition", { toolID: tool.id }, output)
   185	            return {
   186	              id: tool.id,
   187	              description: output.description,
   188	              parameters: output.parameters,
   189	              execute: next.execute,
   190	              formatValidationError: next.formatValidationError,
   191	            }
   192	          }),
   193	          { concurrency: "unbounded" },
   194	        )
   195	      })
   196	
   197	      return Service.of({ register, ids, tools })
   198	    }),
   199	  )
   200	
   201	  export const defaultLayer = Layer.unwrap(
   202	    Effect.sync(() => layer.pipe(Layer.provide(Config.defaultLayer), Layer.provide(Plugin.defaultLayer))),
   203	  )
   204	
   205	  const { runPromise } = makeRuntime(Service, defaultLayer)
   206	
   207	  export async function register(tool: Tool.Info) {
   208	    return runPromise((svc) => svc.register(tool))
   209	  }
   210	
   211	  export async function ids() {
   212	    return runPromise((svc) => svc.ids())
   213	  }
   214	
   215	  export async function tools(
   216	    model: {
   217	      providerID: ProviderID
   218	      modelID: ModelID
   219	    },
   220	    agent?: Agent.Info,
   221	  ): Promise<(Tool.Def & { id: string })[]> {
   222	    return runPromise((svc) => svc.tools(model, agent))
   223	  }
   224	}

