    25	        describe: "refresh the models cache from models.dev",
    26	        type: "boolean",
    27	      })
    28	  },
    29	  handler: async (args) => {
    30	    if (args.refresh) {
    31	      await ModelsDev.refresh()
    32	      UI.println(UI.Style.TEXT_SUCCESS_BOLD + "Models cache refreshed" + UI.Style.TEXT_NORMAL)
    33	    }
    34	
    35	    await Instance.provide({
    36	      directory: process.cwd(),
