    40	        function printModels(providerID: ProviderID, verbose?: boolean) {
    41	          const provider = providers[providerID]
    42	          const sortedModels = Object.entries(provider.models).sort(([a], [b]) => a.localeCompare(b))
    43	          for (const [modelID, model] of sortedModels) {
    44	            process.stdout.write(`${providerID}/${modelID}`)
    45	            process.stdout.write(EOL)
    46	            if (verbose) {
    47	              process.stdout.write(JSON.stringify(model, null, 2))
    48	              process.stdout.write(EOL)
    49	            }
    50	          }
    51	        }
    52	
    53	        if (args.provider) {
    54	          const provider = providers[ProviderID.make(args.provider)]
    55	          if (!provider) {
    56	            UI.error(`Provider not found: ${args.provider}`)
    57	            return
    58	          }
    59	
    60	          printModels(ProviderID.make(args.provider), args.verbose)
    61	          return
    62	        }
    63	
    64	        const providerIDs = Object.keys(providers).sort((a, b) => {
    65	          const aIsOpencode = a.startsWith("opencode")
    66	          const bIsOpencode = b.startsWith("opencode")
    67	          if (aIsOpencode && !bIsOpencode) return -1
    68	          if (!aIsOpencode && bIsOpencode) return 1
    69	          return a.localeCompare(b)
    70	        })
    71	
    72	        for (const providerID of providerIDs) {
    73	          printModels(ProviderID.make(providerID), args.verbose)
    74	        }
    75	      },
    76	    })
