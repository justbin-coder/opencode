`OPENCODE_TEST_HOME` 只能影响 `Global.Path.home`，不能隔离 `data/cache/config/state`，因为这些目录在模块加载时直接基于 `xdg-basedir` 计算。这说明测试隔离和首次运行隔离并不完整，运行时仍会命中用户真实的 XDG 目录。
exec
/bin/zsh -lc 'tmp=$(mktemp -d); export XDG_DATA_HOME=$tmp/data XDG_CONFIG_HOME=$tmp/config XDG_CACHE_HOME=$tmp/cache XDG_STATE_HOME=$tmp/state OPENCODE_DISABLE_MODELS_FETCH=1; mkdir -p $XDG_DATA_HOME $XDG_CONFIG_HOME $XDG_CACHE_HOME $XDG_STATE_HOME; echo $tmp; bun run --cwd packages/opencode src/index.ts debug paths' in /Users/justbin/project/opensource/opencode
exec
