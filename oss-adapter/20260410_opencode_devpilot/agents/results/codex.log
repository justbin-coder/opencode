   343	  async function loadPlugin(dir: string) {
   344	    const plugins: PluginSpec[] = []
   345	
   346	    for (const item of await Glob.scan("{plugin,plugins}/*.{ts,js}", {
   347	      cwd: dir,
   348	      absolute: true,
   349	      dot: true,
   350	      symlink: true,
   351	    })) {
   352	      plugins.push(pathToFileURL(item).href)
   353	    }
   354	    return plugins
   355	  }
   356	
   357	  export function pluginSpecifier(plugin: PluginSpec): string {
   358	    return Array.isArray(plugin) ? plugin[0] : plugin
   359	  }
   360	
   361	  export function pluginOptions(plugin: PluginSpec): PluginOptions | undefined {
   362	    return Array.isArray(plugin) ? plugin[1] : undefined
   363	  }
   364	
   365	  export async function resolvePluginSpec(plugin: PluginSpec, configFilepath: string): Promise<PluginSpec> {
   366	    const spec = pluginSpecifier(plugin)
   367	    if (!isPathPluginSpec(spec)) return plugin
   368	
   369	    const base = path.dirname(configFilepath)
   370	    const file = (() => {
   371	      if (spec.startsWith("file://")) return spec
   372	      if (path.isAbsolute(spec) || /^[A-Za-z]:[\\/]/.test(spec)) return pathToFileURL(spec).href
   373	      return pathToFileURL(path.resolve(base, spec)).href
   374	    })()
   375	
   376	    const resolved = await resolvePathPluginTarget(file).catch(() => file)
   377	
   378	    if (Array.isArray(plugin)) return [resolved, plugin[1]]
   379	    return resolved
   380	  }
   381	
   382	  /**
   383	   * Deduplicates plugins by name, with later entries (higher priority) winning.
   384	   * Priority order (highest to lowest):
   385	   * 1. Local plugin/ directory
   386	   * 2. Local opencode.json
   387	   * 3. Global plugin/ directory
   388	   * 4. Global opencode.json
   389	   *
   390	   * Since plugins are added in low-to-high priority order,
   391	   * we reverse, deduplicate (keeping first occurrence), then restore order.
   392	   */
   393	  export function deduplicatePlugins(plugins: PluginSpec[]): PluginSpec[] {
   394	    const seenNames = new Set<string>()
   395	    const uniqueSpecifiers: PluginSpec[] = []
   396	
   397	    for (const specifier of plugins.toReversed()) {
   398	      const spec = pluginSpecifier(specifier)
   399	      const name = spec.startsWith("file://") ? spec : parsePluginSpecifier(spec).pkg
   400	      if (!seenNames.has(name)) {
   401	        seenNames.add(name)
   402	        uniqueSpecifiers.push(specifier)
   403	      }
   404	    }
   405	
   406	    return uniqueSpecifiers.toReversed()
   407	  }
