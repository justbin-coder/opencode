   582	        .describe("Hex color code (e.g., #FF5733) or theme color (e.g., primary)"),
   583	      steps: z
   584	        .number()
   585	        .int()
   586	        .positive()
   587	        .optional()
   588	        .describe("Maximum number of agentic iterations before forcing text-only response"),
   589	      maxSteps: z.number().int().positive().optional().describe("@deprecated Use 'steps' field instead."),
   590	      permission: Permission.optional(),
   591	    })
   592	    .catchall(z.any())
   593	    .transform((agent, ctx) => {
   594	      const knownKeys = new Set([
   595	        "name",
   596	        "model",
   597	        "variant",
   598	        "prompt",
   599	        "description",
   600	        "temperature",
   601	        "top_p",
   602	        "mode",
   603	        "hidden",
   604	        "color",
   605	        "steps",
   606	        "maxSteps",
   607	        "options",
   608	        "permission",
   609	        "disable",
   610	        "tools",
   611	      ])
   612	
   613	      // Extract unknown properties into options
   614	      const options: Record<string, unknown> = { ...agent.options }
   615	      for (const [key, value] of Object.entries(agent)) {
   616	        if (!knownKeys.has(key)) options[key] = value
   617	      }
   618	
   619	      // Convert legacy tools config to permissions
   620	      const permission: Permission = {}
   621	      for (const [tool, enabled] of Object.entries(agent.tools ?? {})) {
   622	        const action = enabled ? "allow" : "deny"
   623	        // write, edit, patch, multiedit all map to edit permission
   624	        if (tool === "write" || tool === "edit" || tool === "patch" || tool === "multiedit") {
   625	          permission.edit = action
   626	        } else {
   627	          permission[tool] = action
   628	        }
   629	      }
   630	      Object.assign(permission, agent.permission)
   631	
   632	      // Convert legacy maxSteps to steps
   633	      const steps = agent.steps ?? agent.maxSteps
   634	
   635	      return { ...agent, options, permission, steps } as typeof agent & {
   636	        options?: Record<string, unknown>
   637	        permission?: Permission
   638	        steps?: number
   639	      }
   640	    })
