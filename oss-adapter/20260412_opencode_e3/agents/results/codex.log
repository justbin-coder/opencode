   270	  function expand(pattern: string): string {
   271	    if (pattern.startsWith("~/")) return os.homedir() + pattern.slice(1)
   272	    if (pattern === "~") return os.homedir()
   273	    if (pattern.startsWith("$HOME/")) return os.homedir() + pattern.slice(5)
   274	    if (pattern.startsWith("$HOME")) return os.homedir() + pattern.slice(5)
   275	    return pattern
   276	  }
