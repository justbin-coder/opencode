   298	  export function disabled(tools: string[], ruleset: Ruleset): Set<string> {
   299	    const result = new Set<string>()
   300	    for (const tool of tools) {
   301	      const permission = EDIT_TOOLS.includes(tool) ? "edit" : tool
   302	      const rule = ruleset.findLast((rule) => Wildcard.match(permission, rule.permission))
   303	      if (!rule) continue
   304	      if (rule.pattern === "*" && rule.action === "deny") result.add(tool)
   305	    }
   306	    return result
   307	  }
