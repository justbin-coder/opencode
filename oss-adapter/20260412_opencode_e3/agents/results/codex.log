   103	        )
   104	      }
   105	    }
   106	  })
   107	
   108	  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
   109	    throw new Error("Tool params must be an object.")
   110	  }
   111	  return parsed as Record<string, unknown>
   112	}
   113	
   114	async function createToolContext(agent: Agent.Info) {
   115	  const session = await Session.create({ title: `Debug tool run (${agent.name})` })
   116	  const messageID = MessageID.ascending()
   117	  const model = agent.model ?? (await Provider.defaultModel())
   118	  const now = Date.now()
   119	  const message: MessageV2.Assistant = {
   120	    id: messageID,
   121	    sessionID: session.id,
   122	    role: "assistant",
   123	    time: {
   124	      created: now,
   125	    },
   126	    parentID: messageID,
   127	    modelID: model.modelID,
   128	    providerID: model.providerID,
   129	    mode: "debug",
   130	    agent: agent.name,
   131	    path: {
   132	      cwd: Instance.directory,
   133	      root: Instance.worktree,
   134	    },
   135	    cost: 0,
   136	    tokens: {
   137	      input: 0,
   138	      output: 0,
   139	      reasoning: 0,
   140	      cache: {
   141	        read: 0,
   142	        write: 0,
   143	      },
   144	    },
   145	  }
   146	  await Session.updateMessage(message)
   147	
   148	  const ruleset = Permission.merge(agent.permission, session.permission ?? [])
   149	
   150	  return {
   151	    sessionID: session.id,
   152	    messageID,
   153	    callID: PartID.ascending(),
   154	    agent: agent.name,
   155	    abort: new AbortController().signal,
   156	    messages: [],
   157	    metadata: () => {},
   158	    async ask(req: Omit<Permission.Request, "id" | "sessionID" | "tool">) {
   159	      for (const pattern of req.patterns) {
   160	        const rule = Permission.evaluate(req.permission, pattern, ruleset)
   161	        if (rule.action === "deny") {
   162	          throw new Permission.DeniedError({ ruleset })
   163	        }
   164	      }
   165	    },
   166	  }
   167	}

