   278	  export function fromConfig(permission: Config.Permission) {
   279	    const ruleset: Ruleset = []
   280	    for (const [key, value] of Object.entries(permission)) {
   281	      if (typeof value === "string") {
   282	        ruleset.push({ permission: key, action: value, pattern: "*" })
   283	        continue
   284	      }
   285	      ruleset.push(
   286	        ...Object.entries(value).map(([pattern, action]) => ({ permission: key, pattern: expand(pattern), action })),
   287	      )
   288	    }
   289	    return ruleset
   290	  }
