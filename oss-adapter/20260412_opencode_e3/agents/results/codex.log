    89	function parseToolParams(input?: string) {
    90	  if (!input) return {}
    91	  const trimmed = input.trim()
    92	  if (trimmed.length === 0) return {}
    93	
    94	  const parsed = iife(() => {
    95	    try {
    96	      return JSON.parse(trimmed)
    97	    } catch (jsonError) {
    98	      try {
    99	        return new Function(`return (${trimmed})`)()
   100	      } catch (evalError) {
