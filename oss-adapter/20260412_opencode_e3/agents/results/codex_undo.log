   143	  export async function computeDiff(input: { messages: MessageV2.WithParts[] }) {
   144	    let from: string | undefined
   145	    let to: string | undefined
   146	
   147	    // scan assistant messages to find earliest from and latest to
   148	    // snapshot
   149	    for (const item of input.messages) {
   150	      if (!from) {
   151	        for (const part of item.parts) {
   152	          if (part.type === "step-start" && part.snapshot) {
   153	            from = part.snapshot
   154	            break
   155	          }
   156	        }
   157	      }
   158	
   159	      for (const part of item.parts) {
   160	        if (part.type === "step-finish" && part.snapshot) {
   161	          to = part.snapshot
   162	        }
   163	      }
   164	    }
   165	
   166	    if (from && to) return Snapshot.diffFull(from, to)
   167	    return []
   168	  }
   169	}

