   156	}
   157	
   158	function list(dir: string, name: string, out: string[] = []) {
   159	  if (!fs.existsSync(dir)) return out
   160	  for (const item of fs.readdirSync(dir, { withFileTypes: true })) {
   161	    const file = path.join(dir, item.name)
   162	    if (item.isDirectory()) {
   163	      list(file, name, out)
   164	      continue
   165	    }
   166	    if (item.name === name) out.push(norm(file))
   167	  }
   168	  return out
   169	}
   170	
   171	function split(txt: string) {
   172	  const next = unix(txt)
   173	  if (next === "") return { lines: [] as string[], eof: false }
   174	  if (next.endsWith("\n")) return { lines: next.slice(0, -1).split("\n"), eof: true }
   175	  return { lines: next.split("\n"), eof: false }
   176	}
   177	
   178	function parseCfg() {
