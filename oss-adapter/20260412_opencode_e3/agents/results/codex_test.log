   234	      const body = parseTokens(item[2] ?? "")
   235	      if (body.some((tok) => matchFile(base, tok, testFile))) hits.push(item[1])
   236	    }
   237	  }
   238	  return { target: hits[0], files }
   239	}
   240	
   241	export function parseErrors(txt: string) {
   242	  const out: Err[] = []
   243	  const seen = new Set<string>()
   244	
   245	  for (const item of unix(txt).matchAll(/^(.+?):(\d+):(?:(\d+):)?\s*(error|warning):\s*(.+)$/gm)) {
   246	    const one = {
   247	      file: item[1],
   248	      line: Number(item[2]),
   249	      col: item[3] ? Number(item[3]) : null,
   250	      severity: item[4] as "error" | "warning",
   251	      message: item[5].trim(),
   252	      raw: item[0],
   253	    }
   254	    const key = JSON.stringify(one)
   255	    if (seen.has(key)) continue
   256	    seen.add(key)
   257	    out.push(one)
   258	  }
   259	
   260	  for (const raw of unix(txt).split("\n")) {
   261	    if (!raw.includes("undefined reference to") && !raw.includes("multiple definition of")) continue
   262	    const item = raw.match(/^(.+?):(?:.*?:\s*)?(undefined reference to .+|multiple definition of .+)$/)
   263	    const one = {
   264	      file: item?.[1] ?? "",
   265	      line: null,
   266	      col: null,
   267	      severity: "error" as const,
   268	      message: (item?.[2] ?? raw).trim(),
   269	      raw,
   270	    }
   271	    const key = JSON.stringify(one)
   272	    if (seen.has(key)) continue
   273	    seen.add(key)
   274	    out.push(one)
   275	  }
   276	
   277	  return out
   278	}
   279	
   280	function parsePatch(txt: string) {
   281	  const rows = unix(txt).split("\n")
   282	  const hunks: Hunk[] = []
   283	  let i = 0
   284	
   285	  while (i < rows.length) {
   286	    const row = rows[i]
   287	    const head = row.match(/^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/)
   288	    if (!head) {
   289	      i += 1
   290	      continue
   291	    }
   292	    const hunk: Hunk = {
   293	      oldStart: Number(head[1]),
   294	      oldCount: Number(head[2] ?? "1"),
   295	      newStart: Number(head[3]),
   296	      newCount: Number(head[4] ?? "1"),
   297	      lines: [],
   298	    }
   299	    i += 1
   300	    while (i < rows.length && !rows[i].startsWith("@@ ")) {
   301	      if (rows[i] === "\\ No newline at end of file") {
   302	        i += 1
   303	        continue
   304	      }
   305	      hunk.lines.push(rows[i])
   306	      i += 1
   307	    }
   308	    hunks.push(hunk)
   309	  }
   310	
   311	  if (!hunks.length) throw new Error("patch 缺少有效 hunk")
   312	  return { hunks } satisfies FilePatch
   313	}
   314	
   315	export function validateAppendOnly(txt: string) {
   316	  const rows = unix(txt).split("\n")
   317	  for (const row of rows) {
   318	    if (!row.startsWith("-")) continue
   319	    if (row.startsWith("---")) continue
   320	    return false
   321	  }
   322	  return true
   323	}
   324	
   325	export function applyDiff(src: string, txt: string) {
   326	  const patch = parsePatch(txt)
   327	  const old = split(src)
   328	  const out: string[] = []
   329	  let cur = 0
   330	
   331	  for (const hunk of patch.hunks) {
   332	    const start = Math.max(0, hunk.oldStart - 1)
   333	    while (cur < start) {
   334	      out.push(old.lines[cur] ?? "")
   335	      cur += 1
   336	    }
   337	    for (const row of hunk.lines) {
   338	      const tag = row[0]
   339	      const body = row.slice(1)
   340	      if (tag === " ") {
   341	        if ((old.lines[cur] ?? "") !== body) throw new Error(`patch 上下文不匹配：${body}`)
   342	        out.push(body)
   343	        cur += 1
   344	        continue
   345	      }
   346	      if (tag === "-") {
   347	        if ((old.lines[cur] ?? "") !== body) throw new Error(`patch 删除行不匹配：${body}`)
   348	        cur += 1
   349	        continue
   350	      }
   351	      if (tag === "+") {
   352	        out.push(body)
   353	        continue
   354	      }
   355	      throw new Error(`patch 行格式非法：${row}`)
   356	    }
   357	  }
   358	
   359	  while (cur < old.lines.length) {
   360	    out.push(old.lines[cur] ?? "")
   361	    cur += 1
   362	  }
   363	
   364	  return `${out.join("\n")}${old.eof || out.length ? "\n" : ""}`
   365	}
   366	
   367	function backup(file: string, dir: string, root: string) {
   368	  const to = path.join(dir, rel(root, file))
   369	  mkdir(path.dirname(to))
   370	  fs.copyFileSync(file, to)
   371	  return to
   372	}
   373	
   374	function writeLog(result: string) {
   375	  const s = need()
   376	  mkdir(LOG)
   377	  s.log.push(line(`result: ${result}`))
   378	  fs.writeFileSync(s.logFile, `${s.log.join("\n")}\n`)
   379	  return s.logFile
   380	}
   381	
   382	function prepare(args: Args) {
   383	  if (!args.testFile) return fail("prepare 需要 testFile")
   384	
   385	  const cfg = parseCfg()
   386	  const testFile = norm(path.isAbsolute(args.testFile) ? args.testFile : path.join(cfg.projectRoot, args.testFile))
   387	  if (!fs.existsSync(testFile)) return fail(`测试文件不存在：${testFile}`)
   388	  if (!under(cfg.projectRoot, testFile)) return fail("testFile 必须位于 cpp.projectRoot 内")
   389	
   390	  const buildDir = norm(path.join(cfg.projectRoot, cfg.buildDir))
   391	  const cache = path.join(buildDir, "CMakeCache.txt")
   392	  if (!fs.existsSync(cache)) {
   393	    return fail(`CMakeCache.txt 不存在，请先执行 cmake -B ${cfg.buildDir} 初始化构建目录`, {
   394	      projectRoot: cfg.projectRoot,
   395	      buildDir,
   396	    })
   397	  }
   398	
   399	  const found = discoverTarget(cfg.projectRoot, testFile)
   400	  const target =
   401	    cfg.testTargetDiscovery !== "auto" ? cfg.testTargetDiscovery : found.target
   402	  if (!target) {
   403	    return fail("target 自动发现失败，请在 devpilot.json 配置 cpp.testTarget 或 cpp.testTargetDiscovery", {
   404	      projectRoot: cfg.projectRoot,
   405	      buildDir,
   406	    })
   407	  }
   408	
   409	  const id = stamp()
   410	  const backupDir = path.join(TMP, `compile-fix-${id}`)
   411	  const logFile = path.join(LOG, `compile-fix-${id}.log`)
   412	  const whitelist = Array.from(new Set([testFile, ...found.files]))
   413	  const backups: Record<string, string> = {}
   414	
   415	  mkdir(backupDir)
   416	  mkdir(LOG)
   417	  for (const file of whitelist) {
   418	    if (!fs.existsSync(file)) continue
   419	    backups[file] = backup(file, backupDir, cfg.projectRoot)
   420	  }
   421	
   422	  state = {
   423	    stamp: id,
   424	    testFile,
   425	    projectRoot: cfg.projectRoot,
   426	    buildDir,
   427	    target,
   428	    backupDir,
   429	    logFile,
   430	    maxRounds: args.dryRun ? 0 : clip(args.maxRounds),
   431	    currentRound: 0,
   432	    dryRun: Boolean(args.dryRun),
   433	    errors: [],
   434	    log: [],
   435	    whitelist,
   436	    backups,
   437	  }
   438	
   439	  push(`prepare: test=${rel(cfg.projectRoot, testFile)} target=${target} dryRun=${Boolean(args.dryRun)}`)
   440	  push(`prepare: whitelist=${whitelist.map((x) => rel(cfg.projectRoot, x)).join(", ")}`)
   441	  push(`prepare: initial_hash=${hash(read(testFile))}`)
   442	  flush()
   443	
   444	  return ok({
   445	    status: "ready",
   446	    target,
   447	    projectRoot: cfg.projectRoot,
   448	    buildDir,
   449	    dryRun: state.dryRun,
   450	    maxRounds: state.maxRounds,
   451	    whitelist: whitelist.map((x) => rel(cfg.projectRoot, x)),
   452	  })
   453	}
   454	
   455	function build() {
   456	  const s = need()
   457	  const cmd = `cmake --build ${JSON.stringify(s.buildDir)} --target ${JSON.stringify(s.target)}`
   458	  push(`build: round=${s.currentRound} cmd=${cmd}`)
   459	
   460	  try {
   461	    const out = execSync(cmd, {
   462	      cwd: s.projectRoot,
   463	      encoding: "utf-8",
   464	      stdio: "pipe",
   465	      timeout: 120000,
   466	    })
   467	    s.errors = []
   468	    push(`build: pass`)
   469	    if (out.trim()) push(`build_stdout:\n${out}`)
   470	    flush()
   471	    return ok({
   472	      status: "pass",
   473	      round: s.currentRound,
   474	      currentFile: read(s.testFile),
   475	      logFile: s.logFile,
   476	      log: s.log,
   477	    })
   478	  } catch (err) {
   479	    const out = String((err as { stdout?: Buffer | string }).stdout ?? "")
   480	    const stderr = String((err as { stderr?: Buffer | string; message?: string }).stderr ?? (err as Error).message)
   481	    const raw = `${out}${out && stderr ? "\n" : ""}${stderr}`
   482	    const errors = parseErrors(raw)
   483	    s.errors = errors
   484	    push(`build: fail round=${s.currentRound} errors=${errors.length}`)
   485	    push(`build_stderr:\n${raw}`)
   486	    flush()
   487	    return ok({
   488	      status: "fail",
   489	      round: s.currentRound,
   490	      errors,
   491	      errorsRemaining: errors.length,
   492	      currentFile: read(s.testFile),
   493	      logFile: s.logFile,
   494	      log: s.log,
   495	      stderr: raw,
   496	    })
   497	  }
   498	}
   499	
   500	function apply(args: Args) {
   501	  const s = need()
   502	  if (s.dryRun) return ok({ status: "rejected", reason: "dry-run 模式禁止 apply" })
   503	  if (!args.patch) return fail("apply 需要 patch")
   504	  if (!args.patchFile) return fail("apply 需要 patchFile")
   505	  if (s.currentRound >= s.maxRounds) return ok({ status: "rejected", reason: "已达到最大修复轮数" })
   506	
   507	  const file = norm(path.isAbsolute(args.patchFile) ? args.patchFile : path.join(s.projectRoot, args.patchFile))
   508	  if (!s.whitelist.includes(file)) {
   509	    push(`apply: rejected path=${file}`)
   510	    return ok({ status: "rejected", reason: "patchFile 超出白名单" })
   511	  }
   512	  if (!fs.existsSync(file)) {
   513	    push(`apply: rejected missing=${file}`)
   514	    return ok({ status: "rejected", reason: "patchFile 不存在" })
   515	  }
   516	  if (path.basename(file) === "CMakeLists.txt" && !validateAppendOnly(args.patch)) {
   517	    push(`apply: rejected append_only=${file}`)
   518	    return ok({ status: "rejected", reason: "CMakeLists.txt 仅允许纯追加修改" })
   519	  }
   520	

