@@ -0,0 +1,176 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import fs from "fs"
+import os from "os"
+import path from "path"
+
+import { discoverTarget, parseErrors, validateAppendOnly } from "../../tools/cpp-compile-fix"
+
+const dirs: string[] = []
+
+function temp() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cpp-compile-fix-"))
+  dirs.push(dir)
+  return dir
+}
+
+function write(file: string, txt: string) {
+  fs.mkdirSync(path.dirname(file), { recursive: true })
+  fs.writeFileSync(file, txt)
+}
+
+afterEach(() => {
+  for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true })
+})
+
+describe("parseErrors", () => {
+  test("parses gcc style errors", () => {
+    const out = parseErrors("/path/to/file.cpp:10:5: error: 'foo' was not declared in this scope")
+    expect(out).toHaveLength(1)
+    expect(out[0]).toMatchObject({
+      file: "/path/to/file.cpp",
+      line: 10,
+      col: 5,
+      severity: "error",
+      message: "'foo' was not declared in this scope",
+    })
+  })
+
+  test("parses clang undeclared identifier errors", () => {
+    const out = parseErrors("/path/to/file.cpp:10:5: error: use of undeclared identifier 'foo'")
+    expect(out).toHaveLength(1)
+    expect(out[0]).toMatchObject({
+      file: "/path/to/file.cpp",
+      line: 10,
+      col: 5,
+      severity: "error",
+      message: "use of undeclared identifier 'foo'",
+    })
+  })
+
+  test("parses warnings as warning severity", () => {
+    const out = parseErrors("/path/to/file.cpp:11:3: warning: unused variable 'foo'")
+    expect(out).toHaveLength(1)
+    expect(out[0]).toMatchObject({
+      severity: "warning",
+      line: 11,
+      col: 3,
+      message: "unused variable 'foo'",
+    })
+  })
+
+  test("parses undefined reference linker errors", () => {
+    const out = parseErrors("/path/to/file.cpp:(.text+0x5): undefined reference to 'bar'")
+    expect(out).toHaveLength(1)
+    expect(out[0]).toMatchObject({
+      file: "/path/to/file.cpp",
+      line: null,
+      col: null,
+      severity: "error",
+      message: "undefined reference to 'bar'",
+    })
+  })
+
+  test("parses multiple definition linker errors", () => {
+    const out = parseErrors("multiple definition of 'baz'")
+    expect(out).toHaveLength(1)
+    expect(out[0]).toMatchObject({
+      file: "",
+      line: null,
+      col: null,
+      severity: "error",
+      message: "multiple definition of 'baz'",
+    })
+  })
+
+  test("returns empty array for empty stderr", () => {
+    expect(parseErrors("")).toEqual([])
+  })
+
+  test("ignores unrelated lines in mixed stderr", () => {
+    const txt = [
+      "[ 50%] Building CXX object",
+      "note: this line should be ignored",
+      "/path/to/file.cpp:10:5: error: use of undeclared identifier 'foo'",
+      "ld: warning: duplicate library ignored",
+      "/path/to/file.cpp:12:1: warning: control reaches end of non-void function",
+    ].join("\n")
+    const out = parseErrors(txt)
+    expect(out).toHaveLength(2)
+    expect(out.map((item) => item.severity)).toEqual(["error", "warning"])
+  })
+})
+
+describe("validateAppendOnly", () => {
+  test("accepts pure append diffs", () => {
+    const txt = ["--- a/tests/CMakeLists.txt", "+++ b/tests/CMakeLists.txt", "@@ -1,1 +1,2 @@", "+add_executable(foo foo.cpp)"].join(
+      "\n",
+    )
+    expect(validateAppendOnly(txt)).toBe(true)
+  })
+
+  test("rejects diffs with deletion lines", () => {
+    const txt = ["--- a/tests/CMakeLists.txt", "+++ b/tests/CMakeLists.txt", "@@ -1,2 +1,1 @@", "-add_executable(foo foo.cpp)"].join(
+      "\n",
+    )
+    expect(validateAppendOnly(txt)).toBe(false)
+  })
+
+  test("accepts context hunks with appended lines", () => {
+    const txt = [
+      "--- a/tests/CMakeLists.txt",
+      "+++ b/tests/CMakeLists.txt",
+      "@@ -1,2 +1,3 @@",
+      " find_package(GTest REQUIRED)",
+      " add_executable(calculator_test calculator_test.cpp ../src/calculator.cpp)",
+      "+target_compile_features(calculator_test PRIVATE cxx_std_17)",
+    ].join("\n")
+    expect(validateAppendOnly(txt)).toBe(true)
+  })
+
+  test("accepts empty diffs", () => {
+    expect(validateAppendOnly("")).toBe(true)
+  })
+})
+
+describe("discoverTarget", () => {
+  test("finds targets from add_executable", () => {
+    const dir = temp()
+    const file = path.join(dir, "tests", "calculator_test.cpp")
+    write(
+      path.join(dir, "tests", "CMakeLists.txt"),
+      "add_executable(calculator_test calculator_test.cpp ../src/calculator.cpp)\n",
+    )
+    write(file, "// test\n")
+    expect(discoverTarget(dir, file).target).toBe("calculator_test")
+  })
+
+  test("finds executable names with multiple sources", () => {
+    const dir = temp()
+    const file = path.join(dir, "tests", "my_test.cpp")
+    write(
+      path.join(dir, "tests", "CMakeLists.txt"),
+      "add_executable(my_test my_test.cpp helper.cpp)\n",
+    )
+    write(file, "// test\n")
+    expect(discoverTarget(dir, file).target).toBe("my_test")
+  })
+
+  test("finds targets from target_sources without add_executable", () => {
+    const dir = temp()
+    const file = path.join(dir, "tests", "my_test.cpp")
+    write(
+      path.join(dir, "tests", "CMakeLists.txt"),
+      ["add_library(core STATIC ../src/core.cpp)", "target_sources(my_test PRIVATE my_test.cpp helper.cpp)"].join("\n"),
+    )
+    write(file, "// test\n")
+    expect(discoverTarget(dir, file).target).toBe("my_test")
+  })
+
+  test("returns undefined when no target matches", () => {
+    const dir = temp()
+    const file = path.join(dir, "tests", "missing_test.cpp")
+    write(path.join(dir, "tests", "CMakeLists.txt"), "add_executable(other other.cpp)\n")
+    write(file, "// test\n")
+    expect(discoverTarget(dir, file).target).toBeUndefined()
+  })
+})
