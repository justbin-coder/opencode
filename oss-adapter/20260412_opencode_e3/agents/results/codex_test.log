   195	    throw new Error("cpp.projectRoot 必须是绝对路径")
   196	  }
   197	  return {
   198	    projectRoot: norm(root),
   199	    buildDir: typeof dir === "string" && dir.trim() ? dir.trim() : "build",
   200	    testTargetDiscovery: typeof mode === "string" && mode.trim() ? mode.trim() : "auto",
   201	  } satisfies Cfg
   202	}
   203	
   204	function parseTokens(txt: string) {
   205	  return txt
   206	    .replace(/#[^\n]*/g, " ")
   207	    .replace(/[\r\n\t]/g, " ")
   208	    .split(/\s+/)
   209	    .map((x) => x.trim())
   210	    .filter(Boolean)

