   189	  const dir = raw.cpp.buildDir
   190	  const mode = raw.cpp.testTargetDiscovery
   191	  if (typeof root !== "string" || !root.trim()) {
   192	    throw new Error("devpilot.json 缺少 cpp.projectRoot，且必须是绝对路径字符串")
   193	  }
