+#!/usr/bin/env bash
+set -euo pipefail
+
+root="$(cd "$(dirname "$0")" && pwd)"
+out="$root/scenario-results.json"
+log="$root/scenario.log"
+
+rm -f "$out" "$log"
+rm -rf "$root/build"
+
+orig="$root/tests/calculator_test.cpp"
+tmp="$root/tests/calculator_test.orig.cpp"
+bad="$root/tests/calculator_test_broken.cpp"
+
+run() {
+  local txt
+  txt="$(printf '%s' "$1" | bun "$root/tool.ts")"
+  printf '%s\n' "$txt" >>"$log"
+  printf '%s' "$txt"
+}
+
+json() {
+  bun -e "const data = JSON.parse(process.argv[1]); const expr = process.argv[2]; console.log(eval(expr))" "$1" "$2"
+}
+
+printf '%s\n' "Running E3 scenarios in $root" >>"$log"
+
+s1="FAIL"
+s2="FAIL"
+s3="FAIL"
+s4="FAIL"
+s5="FAIL"
+s6="FAIL"
+note=""
+
+r1="$(run '[{"action":"prepare","testFile":"tests/calculator_test.cpp"}]')"
+if [ "$(json "$r1" 'data[0].status')" = "error" ] && [[ "$(json "$r1" 'data[0].message')" == *"CMakeCache.txt 不存在"* ]]; then
+  s1="PASS"
