   218	  if (formatted) UI.error(formatted)
   219	  if (formatted === undefined) {
   220	    UI.error("Unexpected error, check log file at " + Log.file() + " for more details" + EOL)
   221	    process.stderr.write(errorMessage(e) + EOL)
   222	  }
   223	  process.exitCode = 1
   224	} finally {
   225	  // Some subprocesses don't react properly to SIGTERM and similar signals.
   226	  // Most notably, some docker-container-based MCP servers don't handle such signals unless
   227	  // run using `docker run --init`.
   228	  // Explicitly exit to avoid any hanging subprocesses.
   229	  process.exit()
   230	}

