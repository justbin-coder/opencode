     4	
     5	const id = "internal:sidebar-todo"
     6	
     7	function View(props: { api: TuiPluginApi; session_id: string }) {
     8	  const [open, setOpen] = createSignal(true)
     9	  const theme = () => props.api.theme.current
    10	  const list = createMemo(() => props.api.state.session.todo(props.session_id))
    11	  const show = createMemo(() => list().length > 0 && list().some((item) => item.status !== "completed"))
    12	
    13	  return (
    14	    <Show when={show()}>
    15	      <box>
    16	        <box flexDirection="row" gap={1} onMouseDown={() => list().length > 2 && setOpen((x) => !x)}>
    17	          <Show when={list().length > 2}>
    18	            <text fg={theme().text}>{open() ? "▼" : "▶"}</text>
    19	          </Show>
    20	          <text fg={theme().text}>
    21	            <b>Todo</b>
    22	          </text>
    23	        </box>
    24	        <Show when={list().length <= 2 || open()}>
    25	          <For each={list()}>{(item) => <TodoItem status={item.status} content={item.content} />}</For>
    26	        </Show>
    27	      </box>
    28	    </Show>
    29	  )
    30	}
    31	
    32	const tui: TuiPlugin = async (api) => {
    33	  api.slots.register({
    34	    order: 400,
    35	    slots: {
    36	      sidebar_content(_ctx, props) {
    37	        return <View api={api} session_id={props.session_id} />
    38	      },
    39	    },
    40	  })
    41	}
